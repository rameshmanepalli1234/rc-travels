# Site access (existing)
ACCESS_KEY=your_access_key

# CopilotKit open-source runtime (REQUIRED for Travel Assistant chat)
# Setup:
#   yarn setup:env
#   Then edit .env and paste your real key below.
# Get a key: https://platform.openai.com/api-keys
# The key must have billing/credits — "insufficient_quota" means add funds at:
# https://platform.openai.com/account/billing
OPENAI_API_KEY=sk-your-openai-api-key

# CopilotKit Express server port (default: 4000)
COPILOTKIT_PORT=4000

# Disable CopilotKit telemetry (prevents server crash after chat messages in dev)
COPILOTKIT_TELEMETRY_DISABLED=true

# Optional: override CopilotKit URL (dev defaults to http://127.0.0.1:4000/api/copilotkit)
# REACT_APP_COPILOT_RUNTIME_URL=http://127.0.0.1:4000/api/copilotkit
