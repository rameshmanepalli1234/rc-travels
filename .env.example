# Site access
ACCESS_KEY=your_access_key

# Google Gemini — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Optional: gemini-2.5-flash (default, free tier), gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.5-flash

# Travel Assistant API port (default: 4000)
# ASSISTANT_PORT=4000

# Frontend API path (dev uses webpack proxy)
# REACT_APP_TRAVEL_ASSISTANT_API=/api/travel-assistant

# --- Netlify deploy ---
# In Netlify UI: Site configuration → Environment variables
#   GEMINI_API_KEY = your key (required)
#   GEMINI_MODEL   = gemini-2.5-flash (optional)
# Build command: yarn build   Publish directory: dist
# Functions run automatically from netlify/functions/
