# Site access
ACCESS_KEY=your_access_key

# Google Gemini — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash



# resend.com — Book Now emails
BOOKING_RESEND_API_KEY=resend_api_key
# FROM (sender): test mode MUST be onboarding@resend.dev — not your personal email
BOOKING_RESEND_FROM=onboarding@resend.dev
# TO (inbox): test mode MUST be the email you used to sign up at Resend
BOOKING_NOTIFY_EMAIL=rameshtravelszone@gmail.com


