# Site access
ACCESS_KEY=your_access_key

# Google Gemini — free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key


# Optional: gemini-2.5-flash (default, free tier), gemini-2.0-flash-lite
# GEMINI_MODEL=gemini-2.5-flash

# Travel Assistant API port (default: 4000)
# ASSISTANT_PORT=4000

# Frontend API path (dev uses webpack proxy)
# REACT_APP_TRAVEL_ASSISTANT_API=/api/travel-assistant
# REACT_APP_BOOKING_API=/api/booking
# REACT_APP_CONTACT_API=/api/contact

# --- Tour booking emails (Book Now) ---
# Option A — Resend (recommended for Netlify): https://resend.com
# BOOKING_RESEND_API_KEY=re_xxxx
# BOOKING_RESEND_FROM=onboarding@resend.dev
#
# Resend FREE test mode (before domain verification):
#   • Emails can ONLY be delivered to the email on your Resend account
#   • Set BOOKING_NOTIFY_EMAIL to that same address (e.g. you@company.com)
#
# Production (send to rameshtravelszone@gmail.com or any inbox):
#   1. Verify your domain at https://resend.com/domains
#   2. BOOKING_RESEND_FROM=bookings@yourdomain.com
#   3. BOOKING_NOTIFY_EMAIL=rameshtravelszone@gmail.com
# BOOKING_NOTIFY_EMAIL=rameshtravelszone@gmail.com

# Option B — Gmail SMTP (local dev; use App Password)
# BOOKING_SMTP_HOST=smtp.gmail.com
# BOOKING_SMTP_PORT=587
# BOOKING_SMTP_USER=rameshtravelszone@gmail.com
# BOOKING_SMTP_PASS=your_gmail_app_password
# BOOKING_NOTIFY_EMAIL=rameshtravelszone@gmail.com

# --- Netlify deploy ---
# In Netlify UI: Site configuration → Environment variables
#   GEMINI_API_KEY = your key (required)
#   GEMINI_MODEL   = gemini-2.5-flash (optional)
# Build command: yarn build   Publish directory: dist
# Functions run automatically from netlify/functions/
